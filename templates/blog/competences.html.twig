{% extends 'base.html.twig' %}

{% block title %}Mes Compétences - Enzo Pericci{% endblock %}

{% block body %}
<style>
    /* On laisse le body géré par Bootswatch / theme.css */

    .competences-container {
        max-width: 1200px;
        margin: 4rem auto;
        padding: 0 2rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .page-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .page-header h1 {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .page-header p {
        font-size: 1rem;
        opacity: 0.8;
    }

    /* Encadrés : utilisent les variables de ton thème */
    .competence-card {
        background: var(--card-bg);
        color: var(--text-color);
        border-radius: 15px;
        padding: 2.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 40px var(--shadow);
        border: 1px solid var(--border-color);
    }

    .competence-card h2 {
        color: var(--heading-color);
        font-size: 2rem;
        margin-bottom: 1.5rem;
        border-left: 5px solid #f093fb;
        padding-left: 1rem;
    }

    .competence-description {
        margin-bottom: 1.5rem;
        color: var(--text-color);
    }

    .documents-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .documents-list li {
        padding: 0.8rem 1rem;
        margin-bottom: 0.8rem;
        background: var(--bs-body-bg);
        color: var(--text-color);
        border-left: 4px solid #f093fb;
        border-radius: 5px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        border: 1px solid var(--border-color);
    }

    .doc-info {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .doc-code {
        font-weight: bold;
        color: var(--heading-color);
    }

    .doc-type {
        font-size: 0.9rem;
        opacity: 0.8;
        color: var(--text-color);
    }

    .doc-link a {
        text-decoration: none;
        font-weight: 600;
        color: #f5576c;
        transition: transform 0.2s, opacity 0.2s;
        white-space: nowrap;
    }

    .doc-link a:hover {
        opacity: 0.8;
        transform: translateX(2px);
    }

    .btn-back {
        display: inline-block;
        margin-top: 2rem;
        padding: 1rem 2rem;
        background: var(--card-bg);
        color: #f5576c;
        text-decoration: none;
        border-radius: 25px;
        transition: transform 0.3s;
        font-weight: bold;
        box-shadow: 0 5px 20px var(--shadow);
        border: 1px solid var(--border-color);
    }

    .btn-back:hover {
        transform: scale(1.05);
    }

    @media (max-width: 768px) {
        .competences-container {
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .page-header h1 {
            font-size: 2rem;
        }

        .competence-card {
            padding: 1.5rem;
        }

        .doc-link a {
            white-space: normal;
        }
    }
</style>


<div class="competences-container">
